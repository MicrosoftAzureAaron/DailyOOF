<!-- XamlVersion: 1.9.7 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily OOF - Out of Office Automation" Height="880" Width="820"
        MinHeight="750" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn">
            <Setter Property="Background" Value="#D83B01"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A52A00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="tcMain" Grid.Row="0" Margin="10" Background="White" BorderBrush="#D0D0D0">

            <!-- ==================== TAB 1: Quick Actions ==================== -->
            <TabItem Header="  Quick Actions  " FontSize="13" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <GroupBox Header="Connection">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox x:Name="chkOverrideAccount" Content="Override Account:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="txtAccount" Text="(not set)" Width="280" FontSize="13" FontWeight="Bold" Foreground="#0078D4" VerticalContentAlignment="Center" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Status: " FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtConnectionStatus" Text="Disconnected" FontSize="13" Foreground="#D83B01" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnConnect" Content="Connect" Style="{StaticResource PrimaryBtn}"/>
                                    <Button x:Name="btnDisconnect" Content="Disconnect" Style="{StaticResource DangerBtn}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Daily Auto Reply (Run Once Per Day)">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,0,0,8"
                                    Text="Sets Out of Office to Scheduled mode using your configured shift and work day settings. Run this once daily after the start of your shift. To automate this, create a Windows Scheduled Task on the Automation tab."/>
                                <Button x:Name="btnEnableScheduled" Content="Enable Scheduled Auto Reply" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Vacation / Extended OOF">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,0,0,8"
                                    Text="Set an extended Out of Office that runs until your return date. OOF will automatically disable when you return."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Return Date:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="dpReturnDate" Width="200" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock Text="Holiday:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cmbHoliday" Width="340" FontSize="13" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnSetVacation" Content="Set Vacation OOF" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left"/>
                                    <Button x:Name="btnCancelVacation" Content="Cancel Vacation OOF" Style="{StaticResource DangerBtn}" HorizontalAlignment="Left" Margin="8,4,4,4"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Current Auto Reply Status">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="State: " FontSize="13"/>
                                    <TextBlock x:Name="txtARCState" Text="Unknown" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Start: " FontSize="13"/>
                                    <TextBlock x:Name="txtARCStart" Text="-" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="End: " FontSize="13"/>
                                    <TextBlock x:Name="txtARCEnd" Text="-" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnRefreshStatus" Content="Refresh Status" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Width="170" MinWidth="170" MaxWidth="170" Height="36" Margin="4"/>
                                    <Button x:Name="btnViewCurrentMsg" Content="View Current Message" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Width="170" MinWidth="170" MaxWidth="170" Height="36" Margin="4"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB 2: Configuration ==================== -->
            <TabItem Header="  Configuration  " FontSize="13" FontWeight="SemiBold">
                <StackPanel Margin="15">
                        <GroupBox Header="Profile">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Full Name:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="txtFullName" Width="250" FontSize="13" VerticalContentAlignment="Center" Padding="4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Role:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="txtRole" Width="250" FontSize="13" VerticalContentAlignment="Center" Padding="4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Backup:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="txtBackupContact" Width="460" FontSize="13" VerticalContentAlignment="Center" Padding="4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Team Alias:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="txtTeamAlias" Width="460" FontSize="13" VerticalContentAlignment="Center" Padding="4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Support Link:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <TextBox x:Name="txtSupportLink" Width="460" FontSize="13" VerticalContentAlignment="Center" Padding="4"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Office Hours">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Shift Start:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <ComboBox x:Name="cmbStartHour" Width="70" FontSize="13" VerticalContentAlignment="Center"/>
                                    <TextBlock Text=":" FontSize="13" VerticalAlignment="Center" Margin="2,0"/>
                                    <ComboBox x:Name="cmbStartMin" Width="60" FontSize="13" VerticalContentAlignment="Center"/>
                                    <ComboBox x:Name="cmbStartAmPm" Width="60" FontSize="13" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Shift End:" FontSize="13" VerticalAlignment="Center" Width="80"/>
                                    <ComboBox x:Name="cmbEndHour" Width="70" FontSize="13" VerticalContentAlignment="Center"/>
                                    <TextBlock Text=":" FontSize="13" VerticalAlignment="Center" Margin="2,0"/>
                                    <ComboBox x:Name="cmbEndMin" Width="60" FontSize="13" VerticalContentAlignment="Center"/>
                                    <ComboBox x:Name="cmbEndAmPm" Width="60" FontSize="13" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Work Days">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="chkSun" Content="Sunday" FontSize="13" Margin="0,0,16,4"/>
                                    <CheckBox x:Name="chkMon" Content="Monday" FontSize="13" Margin="0,0,16,4"/>
                                    <CheckBox x:Name="chkTue" Content="Tuesday" FontSize="13" Margin="0,0,16,4"/>
                                    <CheckBox x:Name="chkWed" Content="Wednesday" FontSize="13" Margin="0,0,16,4"/>
                                    <CheckBox x:Name="chkThu" Content="Thursday" FontSize="13" Margin="0,0,16,4"/>
                                    <CheckBox x:Name="chkFri" Content="Friday" FontSize="13" Margin="0,0,16,4"/>
                                    <CheckBox x:Name="chkSat" Content="Saturday" FontSize="13" Margin="0,0,16,4"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnPresetMF" Content="Mon-Fri" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnPresetSunWed" Content="Sun-Wed" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnPresetWedSat" Content="Wed-Sat" Style="{StaticResource SecondaryBtn}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Auto Reply State">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="btnStateEnabled" Content="Enabled" Style="{StaticResource PrimaryBtn}"/>
                                    <Button x:Name="btnStateDisabled" Content="Disabled" Style="{StaticResource DangerBtn}"/>
                                    <Button x:Name="btnStateScheduled" Content="Scheduled" Style="{StaticResource SecondaryBtn}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Updates">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Current Version:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="txtLocalVersion" Text="..." FontSize="13" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Latest Version:" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock x:Name="txtRemoteVersion" Text="(not checked)" FontSize="13" Foreground="#888" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="btnCheckForUpdates" Content="Check for Updates" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                        <Button x:Name="btnExportDiagnostics" Content="Export Diagnostics" Style="{StaticResource SecondaryBtn}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- ==================== TAB 3: Automation ==================== -->
            <TabItem Header="  Automation  " FontSize="13" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <GroupBox Header="Scheduled Task">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,0,0,8"
                                    Text="Create or update a Windows scheduled task to run this script with option 1 (daily auto-reply) after your configured shift starts."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Start Offset (min):" FontSize="13" VerticalAlignment="Center" Width="120"/>
                                    <TextBox x:Name="txtTaskOffsetMinutes" Width="70" FontSize="13" VerticalContentAlignment="Center" Padding="4" Text="15"/>
                                </StackPanel>
                                <TextBlock x:Name="txtTaskSummary" Text="Task status not checked yet." FontSize="12" Foreground="#555" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <Border Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Task Status:" FontSize="12" FontWeight="SemiBold" Width="110"/>
                                            <TextBlock x:Name="txtTaskExists" Text="Not checked" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Task State:" FontSize="12" Width="110"/>
                                            <TextBlock x:Name="txtTaskState" Text="-" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Next Run:" FontSize="12" Width="110"/>
                                            <TextBlock x:Name="txtTaskNextRun" Text="-" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Last Run:" FontSize="12" Width="110"/>
                                            <TextBlock x:Name="txtTaskLastRun" Text="-" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Last Result:" FontSize="12" Width="110"/>
                                            <TextBlock x:Name="txtTaskLastResult" Text="-" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Script Path:" FontSize="12" Width="110"/>
                                            <TextBlock x:Name="txtTaskScriptPath" Text="-" FontSize="12" TextWrapping="Wrap" Width="520"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#C00" FontStyle="Italic" Margin="0,0,0,6"
                                    Text="Note: You must run this script as Administrator before clicking Create/Update Scheduled Task or Repair Task Path."/>
                                <WrapPanel>
                                    <Button x:Name="btnCreateTask" Content="Create Scheduled Task" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnRepairTaskPath" Content="Repair Task Path" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnEnableTask" Content="Enable Task" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnDisableTask" Content="Disable Task" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnRefreshTaskStatus" Content="Refresh Task Status" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnRunTaskNow" Content="Run Task Now" Style="{StaticResource SecondaryBtn}"/>
                                    <Button x:Name="btnOpenTaskScheduler" Content="Open Task Scheduler" Style="{StaticResource SecondaryBtn}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB 4: Message Templates ==================== -->
            <TabItem Header="  Message Templates  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Select a template or write your own message. Messages are saved as HTML files in the config folder." 
                                   FontSize="12" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Template:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbTemplate" Width="200" FontSize="13" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Normal OOF" IsSelected="True"/>
                                <ComboBoxItem Content="Vacation OOF"/>
                                <ComboBoxItem Content="Sick OOF"/>
                                <ComboBoxItem Content="Holiday OOF"/>
                                <ComboBoxItem Content="Custom..."/>
                            </ComboBox>
                            <Button x:Name="btnLoadTemplate" Content="Load Template" Style="{StaticResource SecondaryBtn}"/>
                            <Button x:Name="btnBrowseFile" Content="Browse File..." Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Template Options" Margin="0,0,0,8" Padding="8,4">
                        <WrapPanel>
                            <CheckBox x:Name="chkIncludeSignature" Content="Include Signature" FontSize="13" Margin="0,0,18,4" IsChecked="True"/>
                            <CheckBox x:Name="chkIncludeOfficeHours" Content="Include Office Hours" FontSize="13" Margin="0,0,18,4" IsChecked="True"/>
                            <CheckBox x:Name="chkIncludeWorkDays" Content="Include Work Days" FontSize="13" Margin="0,0,18,4" IsChecked="True"/>
                            <CheckBox x:Name="chkIncludeTimezone" Content="Include Timezone" FontSize="13" Margin="0,0,18,4" IsChecked="True"/>
                        </WrapPanel>
                    </GroupBox>

                    <TabControl x:Name="tcMessageView" Grid.Row="2" FontSize="12">
                        <TabItem Header="  Edit  " FontWeight="SemiBold">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Background="#F0F0F0" Margin="0,0,0,2">
                                    <Button x:Name="btnFmtBold" Content="B" FontWeight="Bold" ToolTip="Bold  &lt;b&gt;...&lt;/b&gt;" Width="30" Height="28" Margin="2" FontSize="13" Cursor="Hand"/>
                                    <Button x:Name="btnFmtItalic" Content="I" FontStyle="Italic" ToolTip="Italic  &lt;i&gt;...&lt;/i&gt;" Width="30" Height="28" Margin="2" FontSize="13" Cursor="Hand"/>
                                    <Button x:Name="btnFmtUnderline" ToolTip="Underline  &lt;u&gt;...&lt;/u&gt;" Width="30" Height="28" Margin="2" FontSize="13" Cursor="Hand">
                                        <TextBlock TextDecorations="Underline" Text="U"/>
                                    </Button>
                                    <Border Width="1" Background="#CCC" Margin="4,4" Height="20"/>
                                    <Button x:Name="btnFmtH3" Content="H" FontWeight="Bold" ToolTip="Heading  &lt;h3&gt;...&lt;/h3&gt;" Width="30" Height="28" Margin="2" FontSize="13" Cursor="Hand"/>
                                    <Button x:Name="btnFmtP" Content="P" ToolTip="Paragraph  &lt;p&gt;...&lt;/p&gt;" Width="30" Height="28" Margin="2" FontSize="13" Cursor="Hand"/>
                                    <Button x:Name="btnFmtBr" Content="BR" ToolTip="Line Break  &lt;br/&gt;" Width="36" Height="28" Margin="2" FontSize="11" Cursor="Hand"/>
                                    <Border Width="1" Background="#CCC" Margin="4,4" Height="20"/>
                                    <Button x:Name="btnFmtLink" Content="Link" ToolTip="Hyperlink  &lt;a href=...&gt;" Width="42" Height="28" Margin="2" FontSize="11" Cursor="Hand"/>
                                    <Button x:Name="btnFmtColor" Content="Color" ToolTip="Colored text  style='color: #hex'" Width="48" Height="28" Margin="2" FontSize="11" Cursor="Hand"/>
                                    <Button x:Name="btnFmtList" Content="List" ToolTip="Bullet list  &lt;ul&gt;&lt;li&gt;..." Width="42" Height="28" Margin="2" FontSize="11" Cursor="Hand"/>
                                    <Border Width="1" Background="#CCC" Margin="4,4" Height="20"/>
                                    <Button x:Name="btnFmtRef" Content="? HTML Ref" ToolTip="Quick HTML reference" Width="72" Height="28" Margin="2" FontSize="11" Cursor="Hand"/>
                                </WrapPanel>
                                <TextBox x:Name="txtMessage"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="12"
                                         FontFamily="Consolas" Padding="8"
                                         BorderBrush="#D0D0D0" BorderThickness="1"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="  Preview  " FontWeight="SemiBold">
                            <WebBrowser x:Name="wbPreview"/>
                        </TabItem>
                    </TabControl>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnApplyInternal" Content="Apply as Internal Message" Style="{StaticResource PrimaryBtn}"/>
                            <Button x:Name="btnApplyExternal" Content="Apply as External Message" Style="{StaticResource PrimaryBtn}"/>
                            <Button x:Name="btnApplyBoth" Content="Apply as Both" Style="{StaticResource PrimaryBtn}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnSaveTemplate" Content="Save to Template File" Style="{StaticResource SecondaryBtn}"/>
                            <Button x:Name="btnSaveOnlineMsg" Content="Save Online Msg to File" Style="{StaticResource SecondaryBtn}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Current OOF Tab -->
            <TabItem Header="  Current OOF  " FontSize="13" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="btnRefreshCurrentOOF" Content="Refresh from Exchange" Style="{StaticResource PrimaryBtn}"/>
                        <TextBlock x:Name="txtCurrentOOFStatus" Text="Not loaded" FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <WebBrowser x:Name="wbCurrentOOF" Grid.Row="1"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border x:Name="borderStatusBar" Grid.Row="1" Background="#0078D4" Height="28">
            <TextBlock x:Name="txtStatusBar" Text="Ready" Foreground="White" FontSize="12" 
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Border>
    </Grid>
</Window>
